<?xml version="1.0" encoding="utf-8"?>
<!--
  android:allowBackup is "false" in AndroidManifest.xml — this app is fully local
  and financial data (transactions, raw SMS text) must never leave the device via
  Google's cloud backup. This file is inert while allowBackup=false, but is kept
  empty (rather than deleted) so a future accidental allowBackup=true doesn't
  silently re-include the database.
-->
<full-backup-content>
</full-backup-content>
