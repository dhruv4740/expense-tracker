<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background — 108×108dp, full bleed.
  Colour story: deep teal (#0A3D2E) → rich emerald green (#1A7A4A).
  Diagonal gradient (NW→SE / 135°) reads "finance / money" while staying
  dark enough to contrast with the white foreground on any launcher.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Full background rectangle with diagonal gradient fill -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#0A3D2E" />
                <item android:offset="0.5" android:color="#0D5C3E" />
                <item android:offset="1.0" android:color="#1A7A4A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle radial glow centred at safe zone centre (54,54)
         gives the icon depth without adding complexity. -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="60">
                <item android:offset="0.0" android:color="#2A9D6420" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
